{
  "name": "iobroker.samsung_tizen",
  "version": "2.1.0",
  "description": "ioBroker adapter to control Samsung TizenOs tvs(mj>= 2016)",
  "author": "DaHuby <michael.hubeny@me.com>",
  "contributors": [
    "Michael Hubeny <michael.hubeny@me.com>",
    "mcm1957 <mcm57@gmx.at>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.samsung_tizen",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "samsung",
    "tizen",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.samsung_tizen.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "is-port-reachable": "^4.0.0",
    "wake_on_lan": "^1.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@iobroker/types": "^7.2.5",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "build/",
    "admin/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:admin": "node tasks",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint -c eslint.config.mjs",
    "test:package": "mocha test/packageFiles --exit",
    "test:unit": "mocha test/unitScenes --exit",
    "test:integration": "mocha test/integrationAdapter --exit",
    "test": "npm run test:package && npm run test:unit",
    "translate": "translate-adapter -b admin/i18n/en.json",
    "release": "release-script -y",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx -y npm-check-updates --upgrade",
    "npm": "npm i && cd src-admin && npm i -f"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.samsung_tizen/issues"
  },
  "readmeFilename": "README.md"
}
