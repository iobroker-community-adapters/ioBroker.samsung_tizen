                    "command": "remote",
                    "jsonData": "{\"key\":\"KEY_POWER\"}",
                    "variant": "outlined",
                    "showProcess": true,
                    "xs": 4,
                    "sm": 4,
                    "md": 2,
                    "lg": 2,
                    "xl": 1,
                    "newLine": true
